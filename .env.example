# Moonshot Radar V24 — environment template
#
# Production (Vercel): set TURSO_DATABASE_URL + TURSO_AUTH_TOKEN.
# Do NOT set DATABASE_URL, Neon vars, RADAR_API_URL, or V2 vars.

# --- Required for Next.js + Turso (production and local against remote Turso) ---
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=

# --- Local development only (optional file DB; never use on Vercel) ---
# TURSO_DATABASE_URL=file:./data/radar.db
# TURSO_AUTH_TOKEN can be omitted for file: URLs

# --- Cron auth (shared) ---
# Vercel Cron sends Authorization: Bearer ${CRON_SECRET}.
CRON_SECRET=

# Discovery+lifecycle combined collect route (/api/cron/collect).
RADAR24_COLLECT_ENABLED=false

# Max new token_cases created per collect run (discovery safety limit).
V24_MAX_NEW_CASES_PER_RUN=1

# Lifecycle-only cron (/api/cron/lifecycle).
RADAR24_LIFECYCLE_ENABLED=false

# PASS-only push cron (/api/cron/push).
RADAR24_PUSH_ENABLED=false

# Web Push VAPID (required only when actually sending). Never commit real keys.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# --- Optional: legacy Hono API (src/api/server.ts) for local experiments ---
# PORT=8787
# RADAR_API_SECRET=
