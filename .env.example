# Remote Turso database
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=

# Local libSQL file for development (no auth token needed)
# TURSO_DATABASE_URL=file:./data/radar.db

# Read API
PORT=8787

# Write API (push subscriptions). Existing GET /cases stays unauthenticated.
RADAR_API_SECRET=
